# Copy this file to .env and fill in your values.
# Variables already set in the server environment take precedence.

# Database
# Use localhost on CyberPanel (its database users are created for localhost)
DB_HOST=127.0.0.1
# CyberPanel prefixes names, e.g. colle_collegekhoj
DB_NAME=collegekhoj
DB_USER=root
DB_PASSWORD=

# Site
CONTACT_EMAIL=help@collegekhoj.co.in
# Leave commented out to auto-detect (e.g. /webs/collegekhoj_site under XAMPP)
# APP_BASE_PATH=/

# Only needed when running admin/create-admin.php from the CLI
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Site Administrator
